# Open-Meteo needs no API key for free non-commercial use.
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_REQUEST_TIMEOUT=8
WEATHER_CACHE_TTL=600
WEATHER_FORECAST_DAYS=5

# Comma-separated list of frontend origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional: restrict to the ports your project actually uses (comma-separated).
# Leave empty to allow every port in app/data/ports.py.
SUPPORTED_PORTS=

LOG_LEVEL=INFO

# Folder containing dataset CSVs (relative to backend/)
DATA_DIR=data

# SQLite file for Analysis History (relative to backend/)
HISTORY_DB_PATH=data/history.sqlite3
# Congestion CSV filename inside DATA_DIR (blank = first CSV with "congest" in its name)
CONGESTION_FILE=
